{
  "name": "bg_review_versions",
  "primary_key_column": "id",
  "enable_rls": false,
  "columns": [
    {
      "name": "review_id",
      "type": "UUID",
      "required": true,
      "foreign_key": {
        "references": "bg_reviews.id"
      }
    },
    {
      "name": "version",
      "type": "INTEGER",
      "required": true
    },
    {
      "name": "content",
      "type": "TEXT"
    },
    {
      "name": "change_summary",
      "type": "TEXT"
    },
    {
      "name": "change_source",
      "type": "ENUM",
      "options": [
        "original",
        "ai_correction",
        "manual_edit",
        "restore",
        "resubmission"
      ]
    },
    {
      "name": "author_id",
      "type": "UUID"
    },
    {
      "name": "author_email",
      "type": "TEXT"
    },
    {
      "name": "author_name",
      "type": "TEXT"
    },
    {
      "name": "findings_snapshot",
      "type": "JSON"
    },
    {
      "name": "is_approved",
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "approved_by",
      "type": "TEXT"
    },
    {
      "name": "approved_at",
      "type": "DATETIME"
    }
  ]
}
