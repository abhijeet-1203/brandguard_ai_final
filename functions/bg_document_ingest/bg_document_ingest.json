{
  "name": "bg_document_ingest",
  "description": "Register an uploaded pod file as a BrandGuard document and extract its text (PDF/DOCX/MD/TXT converted by the platform).",
  "type": "API",
  "visibility": "POD",
  "code": {
    "$file": "code.py"
  },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "bg_documents",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "bg_memberships",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read"
        ]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "bg_audit_logs",
        "permission_ids": [
          "datastore.table.read",
          "datastore.record.read",
          "datastore.record.write"
        ]
      },
      {
        "resource_type": "folder",
        "resource_name": "/brandguard",
        "permission_ids": [
          "folder.read"
        ]
      }
    ]
  }
}
