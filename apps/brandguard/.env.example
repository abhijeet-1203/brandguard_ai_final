# Development-only fallback. The deployed app receives pod context (podId, apiUrl,
# authUrl) from the host at serve time, so nothing here is needed in production and
# nothing here is a secret.
VITE_LEMMA_POD_ID=019efce1-8f43-75db-849c-842bbe0b6e4d
VITE_LEMMA_API_URL=https://api.lemma.work
VITE_LEMMA_AUTH_URL=https://lemma.work/auth
# Optional: command the dev server uses to seed an access token for local development.
VITE_LEMMA_DEV_TOKEN_CMD=lemma auth print-token
